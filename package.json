{
  "name": "hermes-mini",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless Persian task-assistant Telegram bot — Cloudflare Workers + D1 + Gemini (round-robin)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings tests/quick-test.mts",
    "db:migrate:local": "wrangler d1 execute hermes-mini --local --file migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute hermes-mini --remote --file migrations/0001_init.sql",
    "set:webhook": "node scripts/set-webhook.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
